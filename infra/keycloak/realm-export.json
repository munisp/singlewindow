        "composite": false,
        "clientRole": false
      },
      {
        "name": "port_operator",
        "description": "Port operator managing cargo release and berth scheduling",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "compliance_officer",
        "description": "Compliance officer managing sanctions screening and WCO CEN alerts",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "inspector",
        "description": "Physical inspection officer using vision AI for container checks",
        "composite": false,
        "clientRole": false
      }
