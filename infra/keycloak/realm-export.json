  "authenticationFlows": [
    {
      "alias": "tradegateway-browser-mfa",
      "description": "Browser login with conditional OTP for privileged roles",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "autheticatorFlow": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "requirement": "ALTERNATIVE",
          "priority": 25,
          "autheticatorFlow": false
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "flowAlias": "tradegateway-browser-mfa forms",
          "autheticatorFlow": true
        }
      ]
    },
    {
      "alias": "tradegateway-browser-mfa forms",
      "description": "Username/password + conditional OTP sub-flow",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": true,
          "autheticatorFlow": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "tradegateway-web",
      "name": "TradeGateway Web Portal",
      "description": "Public PKCE client for the React PWA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:9080/*",
        "https://*.manus.space/*"
      ],
      "webOrigins": [
        "+"
      ],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "tradegateway-roles"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:9080/*##https://*.manus.space/*"
      }
    },
    {
      "clientId": "tradegateway-api",
      "name": "TradeGateway API Gateway",
      "description": "Confidential client for APISIX token introspection",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "secret": "tradegateway-api-secret-2026",
      "protocol": "openid-connect",
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "tradegateway-roles"
      ],
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "tradegateway-services",
      "name": "TradeGateway Microservices",
      "description": "Confidential client for service-to-service M2M tokens (client_credentials)",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "tradegateway-services-secret-2026",
      "protocol": "openid-connect",
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "openid",
        "tradegateway-roles"
      ],
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "tradegateway-mobile",
      "name": "TradeGateway Mobile App",
      "description": "Public PKCE client for React Native and Flutter apps",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "tradegateway://auth/callback",
        "com.tradegateway.app://auth/callback"
      ],
      "webOrigins": [],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "tradegateway-roles"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "clientScopes": [
    {
      "name": "tradegateway-roles",
      "description": "TradeGateway platform roles and claims included in tokens",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "tradegateway-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "groups-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        },
        {
          "name": "company-name-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "company_name",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "company_name",
            "jsonType.label": "String"
          }
        },
        {
          "name": "tin-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "tin",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "tin",
            "jsonType.label": "String"
          }
        },
        {
          "name": "aeo-status-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "aeo_status",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "aeo_status",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": true,
      "priority": 50
    },
    {
      "alias": "terms_and_conditions",
      "name": "Terms and Conditions",
      "providerId": "terms_and_conditions",
      "enabled": true,
      "defaultAction": false,
      "priority": 20
    }
  ],
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername and notEmail and passwordHistory(5)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA256",
  "otpPolicyInitialCounter": 0,
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "smtpServer": {
    "host": "${env.SMTP_HOST}",
    "port": "${env.SMTP_PORT}",
    "from": "${env.SMTP_FROM}",
    "fromDisplayName": "TradeGateway NGSWTP",
    "ssl": "true",
    "starttls": "false",
    "auth": "true",
    "user": "${env.SMTP_USER}",
    "password": "${env.SMTP_PASSWORD}"
  },
