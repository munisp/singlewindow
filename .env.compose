# TradeGateway™ NGSWTP — Docker Compose Environment Template
# Copy this file to .env and fill in your values before running:
#   cp .env.compose .env
#   docker compose up -d
#
# Lines starting with # are comments. All values shown are safe defaults
# for local development ONLY. Change all secrets before deploying to production.

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=tradegateway
POSTGRES_PASSWORD=tradegateway_secure_2026
POSTGRES_DB=tradegateway
POSTGRES_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=tradegateway_redis_2026
REDIS_PORT=6379

# ─── Keycloak ─────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_secure_2026
KEYCLOAK_REALM=tradegateway
KEYCLOAK_CLIENT_ID=tradegateway-api
KEYCLOAK_CLIENT_SECRET=change_me_in_production
KEYCLOAK_WEBHOOK_SECRET=webhook_secret_2026

# ─── OpenSearch ───────────────────────────────────────────────────────────────
OPENSEARCH_PASSWORD=TradeGateway@2026!

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=kafka:29092

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
APP_PORT=9000
JWT_SECRET=jwt_secret_change_in_production_min_32_chars_required

# ─── Manus OAuth (leave blank for self-hosted deployments) ────────────────────
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
OWNER_NAME=TradeGateway Admin
BUILT_IN_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=

# ─── MinIO / S3 ───────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_BUCKET=tradegateway

# ─── Temporal ─────────────────────────────────────────────────────────────────
TEMPORAL_HOST=temporal
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=tradegateway

# ─── Observability ────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=tradegateway_grafana_2026

# ─── Demo mode (set to true to enable seeded demo data) ───────────────────────
DEMO_MODE=false

# ─── Pipeline ─────────────────────────────────────────────────────────────────
PIPELINE_MODE=batch
