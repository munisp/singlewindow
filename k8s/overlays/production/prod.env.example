# ─── TradeGateway™ NGSWTP — Production Secrets Template ──────────────────────
# Copy this file to prod.env and fill in real values.
# NEVER commit prod.env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Database
DATABASE_URL=postgresql://tradegateway:CHANGE_ME@tidb-prod.tradegateway.internal:4000/tradegateway?ssl=true

# Redis
REDIS_URL=redis://:CHANGE_ME@redis-prod.tradegateway.internal:6379/0

# Auth
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://auth.manus.im
VITE_APP_ID=CHANGE_ME_APP_ID
OWNER_OPEN_ID=CHANGE_ME_OWNER_OPEN_ID
OWNER_NAME=TradeGateway Admin

# Manus Forge API
BUILT_IN_FORGE_API_KEY=CHANGE_ME_SERVER_FORGE_KEY
BUILT_IN_FORGE_API_URL=https://api.manus.im
VITE_FRONTEND_FORGE_API_KEY=CHANGE_ME_FRONTEND_FORGE_KEY
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im

# AWS S3 (for document storage)
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=eu-west-1
AWS_S3_BUCKET=tradegateway-prod-documents

# Keycloak (optional — set KEYCLOAK_ENABLED=true to activate)
KEYCLOAK_ENABLED=false
KEYCLOAK_REALM_URL=https://keycloak.tradegateway.gov.ng/realms/tradegateway
KEYCLOAK_CLIENT_ID=tradegateway-platform
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# Permify (optional — set PERMIFY_HOST to activate)
PERMIFY_HOST=
PERMIFY_TOKEN=

# Sentry (optional)
SENTRY_DSN=
VITE_SENTRY_DSN=

# Analytics
VITE_ANALYTICS_ENDPOINT=https://analytics.tradegateway.gov.ng
VITE_ANALYTICS_WEBSITE_ID=CHANGE_ME
